{
  "name": "meevo-desktop",
  "productName": "MEEVO",
  "version": "1.0.0",
  "description": "MEEVO para Windows - Conecte. Converse. Compartilhe.",
  "main": "main.js",
  "author": "DALLY",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.dallyverso.meevo",
    "productName": "MEEVO",
    "artifactName": "MEEVO-Setup.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "picker.html", "picker-preload.js", "offline.html", "build/icon.ico", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MEEVO",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "MEEVO"
    },
    "publish": [{ "provider": "github", "releaseType": "release" }]
  }
}
