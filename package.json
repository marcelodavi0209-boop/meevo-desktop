{
  "name": "meevo-desktop",
  "productName": "LEEMO",
  "version": "1.0.3",
  "description": "LEEMO para Windows - Sua galera. Seu lugar.",
  "main": "main.js",
  "author": "DALLY",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.dallyverso.meevo",
    "productName": "LEEMO",
    "artifactName": "LEEMO-Setup.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "splash.html",
      "preload.js",
      "picker.html",
      "picker-preload.js",
      "offline.html",
      "build/icon.ico",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LEEMO",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "uninstallDisplayName": "LEEMO"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "marcelodavi0209-boop",
        "repo": "meevo-desktop",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  }
}
